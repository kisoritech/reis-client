{
  "name": "reis-client",
  "productName": "REIS",
  "version": "0.1.18",
  "private": true,
  "description": "Cliente web e desktop seguro da plataforma REIS",
  "author": "Kisori Tech",
  "homepage": "https://github.com/kisoritech/reis-client",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:desktop": "electron-forge start",
    "build": "npm run typecheck && vite build",
    "build:web": "vite build",
    "build:desktop": "electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish:desktop": "electron-forge publish",
    "app:update": "node scripts/update-app.mjs",
    "app:update:check": "node scripts/update-app.mjs --check",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "electron-squirrel-startup": "^1.0.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.2.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "tmp": "0.2.7"
  }
}
